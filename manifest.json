{
  "manifest_version": 3,
  "name": "CSS Style Guide: Tailwind & Bootstrap",
  "version": "1.0.0",
  "description": "Cari class Tailwind CSS dan Bootstrap, deteksi versinya di halaman aktif, dan edit style elemen langsung di halaman.",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Style Guide: Tailwind & Bootstrap",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
